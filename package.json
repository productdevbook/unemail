{
  "name": "unemail",
  "version": "1.0.0",
  "private": false,
  "description": "Driver-based TypeScript email library. Batch-native middleware pipeline, zero dependencies, ESM-only — runs on Node, Bun, Deno, Cloudflare Workers and the browser.",
  "keywords": [
    "aws-ses",
    "batch-email",
    "dkim",
    "driver",
    "driver-pattern",
    "email",
    "email-service",
    "esm",
    "idempotency",
    "middleware",
    "postmark",
    "react-email",
    "resend",
    "smtp",
    "transactional-email",
    "typescript",
    "zero-dependencies"
  ],
  "homepage": "https://github.com/productdevbook/unemail#readme",
  "bugs": "https://github.com/productdevbook/unemail/issues",
  "license": "MIT",
  "author": "productdevbook <hi@productdevbook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/productdevbook/unemail.git"
  },
  "funding": "https://github.com/sponsors/productdevbook",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./drivers/mock": {
      "types": "./dist/drivers/mock.d.mts",
      "default": "./dist/drivers/mock.mjs"
    },
    "./drivers/smtp": {
      "types": "./dist/drivers/smtp.d.mts",
      "default": "./dist/drivers/smtp.mjs"
    },
    "./drivers/resend": {
      "types": "./dist/drivers/resend.d.mts",
      "default": "./dist/drivers/resend.mjs"
    },
    "./drivers/postmark": {
      "types": "./dist/drivers/postmark.d.mts",
      "default": "./dist/drivers/postmark.mjs"
    },
    "./drivers/ses": {
      "types": "./dist/drivers/ses.d.mts",
      "default": "./dist/drivers/ses.mjs"
    },
    "./drivers/fallback": {
      "types": "./dist/drivers/fallback.d.mts",
      "default": "./dist/drivers/fallback.mjs"
    },
    "./drivers/round-robin": {
      "types": "./dist/drivers/round-robin.d.mts",
      "default": "./dist/drivers/round-robin.mjs"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.mts",
      "default": "./dist/middleware/index.mjs"
    },
    "./render": {
      "types": "./dist/render/index.d.mts",
      "default": "./dist/render/index.mjs"
    },
    "./render/react": {
      "types": "./dist/render/react.d.mts",
      "default": "./dist/render/react.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "obuild",
    "dev": "vitest",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "fmt": "oxfmt .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "check": "bun run lint && bun run typecheck && bun run test && bun run check:version",
    "check:version": "node scripts/check-version.mjs",
    "bundle-budget": "node scripts/bundle-budget.mjs",
    "attw": "bunx --bun @arethetypeswrong/cli --pack . --profile esm-only",
    "jsr:check": "bunx jsr publish --dry-run --allow-dirty",
    "release": "bun run check && bun run build && bun run bundle-budget && bun run attw && bun run jsr:check && bumpp --commit --tag --push --all",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.9",
    "bumpp": "^12.2.2",
    "obuild": "^0.4.36",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.70.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@react-email/render": "*"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.11.1"
  }
}
