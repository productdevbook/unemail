    "./drivers/scaleway": {
      "types": "./dist/drivers/scaleway.d.mts",
      "default": "./dist/drivers/scaleway.mjs"
    },
    "./drivers/sendgrid": {
      "types": "./dist/drivers/sendgrid.d.mts",
      "default": "./dist/drivers/sendgrid.mjs"
    },
    "./drivers/ses": {
      "types": "./dist/drivers/ses.d.mts",
      "default": "./dist/drivers/ses.mjs"
    },
    "./drivers/smtp": {
      "types": "./dist/drivers/smtp.d.mts",
      "default": "./dist/drivers/smtp.mjs"
    },
    "./drivers/smtp2go": {
      "types": "./dist/drivers/smtp2go.d.mts",
      "default": "./dist/drivers/smtp2go.mjs"
