    "./middleware": {
      "types": "./dist/middleware/index.d.mts",
      "default": "./dist/middleware/index.mjs"
    },
    "./render": {
      "types": "./dist/render/index.d.mts",
      "default": "./dist/render/index.mjs"
    },
    "./render/react": {
      "types": "./dist/render/react.d.mts",
      "default": "./dist/render/react.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "obuild",
    "dev": "vitest",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "fmt": "oxfmt .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "check": "bun run lint && bun run typecheck && bun run test:coverage && bun run check:version && bun run check:exports",
    "check:version": "node scripts/check-version.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "bundle-budget": "node scripts/bundle-budget.mjs",
    "attw": "bunx --bun @arethetypeswrong/cli --pack . --profile esm-only",
    "jsr:check": "bunx jsr publish --dry-run --allow-dirty",
    "release": "bun run check && bun run build && bun run bundle-budget && bun run attw && bun run jsr:check && bumpp --commit --tag --push --all",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.9",
    "bumpp": "^12.2.2",
    "obuild": "^0.4.36",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.70.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@react-email/render": "*"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.11.1"
  }
}
