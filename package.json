{
  "name": "unemail",
  "version": "0.7.0",
  "private": false,
  "description": "Driver-based TypeScript email library. Batch-native middleware pipeline, zero dependencies, ESM-only — runs on Node, Bun, Deno, Cloudflare Workers and the browser.",
  "keywords": [
    "aws-ses",
    "batch-email",
    "dkim",
    "driver",
    "driver-pattern",
    "email",
    "email-service",
    "esm",
    "idempotency",
    "middleware",
    "postmark",
    "react-email",
    "resend",
    "smtp",
    "transactional-email",
    "typescript",
    "zero-dependencies"
  ],
  "homepage": "https://github.com/productdevbook/unemail#readme",
  "bugs": "https://github.com/productdevbook/unemail/issues",
  "license": "MIT",
  "author": "productdevbook <hi@productdevbook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/productdevbook/unemail.git"
  },
  "funding": "https://github.com/sponsors/productdevbook",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./drivers/ahasend": {
      "types": "./dist/drivers/ahasend.d.mts",
      "default": "./dist/drivers/ahasend.mjs"
    },
    "./drivers/azure-communication": {
      "types": "./dist/drivers/azure-communication.d.mts",
      "default": "./dist/drivers/azure-communication.mjs"
    },
    "./drivers/brevo": {
      "types": "./dist/drivers/brevo.d.mts",
      "default": "./dist/drivers/brevo.mjs"
    },
    "./drivers/cloudflare-email": {
      "types": "./dist/drivers/cloudflare-email.d.mts",
      "default": "./dist/drivers/cloudflare-email.mjs"
    },
    "./drivers/cloudflare-email-rest": {
      "types": "./dist/drivers/cloudflare-email-rest.d.mts",
      "default": "./dist/drivers/cloudflare-email-rest.mjs"
    },
    "./drivers/cloudflare-email-service": {
      "types": "./dist/drivers/cloudflare-email-service.d.mts",
      "default": "./dist/drivers/cloudflare-email-service.mjs"
    },
    "./drivers/fallback": {
      "types": "./dist/drivers/fallback.d.mts",
      "default": "./dist/drivers/fallback.mjs"
    },
    "./drivers/http": {
      "types": "./dist/drivers/http.d.mts",
      "default": "./dist/drivers/http.mjs"
    },
    "./drivers/loops": {
      "types": "./dist/drivers/loops.d.mts",
      "default": "./dist/drivers/loops.mjs"
    },
    "./drivers/mailbreeze": {
      "types": "./dist/drivers/mailbreeze.d.mts",
      "default": "./dist/drivers/mailbreeze.mjs"
    },
    "./drivers/mailchannels": {
      "types": "./dist/drivers/mailchannels.d.mts",
      "default": "./dist/drivers/mailchannels.mjs"
    },
    "./drivers/mailcrab": {
      "types": "./dist/drivers/mailcrab.d.mts",
      "default": "./dist/drivers/mailcrab.mjs"
    },
    "./drivers/mailersend": {
      "types": "./dist/drivers/mailersend.d.mts",
      "default": "./dist/drivers/mailersend.mjs"
    },
    "./drivers/mailgun": {
      "types": "./dist/drivers/mailgun.d.mts",
      "default": "./dist/drivers/mailgun.mjs"
    },
    "./drivers/mailjet": {
      "types": "./dist/drivers/mailjet.d.mts",
      "default": "./dist/drivers/mailjet.mjs"
    },
    "./drivers/mailpit": {
      "types": "./dist/drivers/mailpit.d.mts",
      "default": "./dist/drivers/mailpit.mjs"
    },
    "./drivers/mailtrap": {
      "types": "./dist/drivers/mailtrap.d.mts",
      "default": "./dist/drivers/mailtrap.mjs"
    },
    "./drivers/mock": {
      "types": "./dist/drivers/mock.d.mts",
      "default": "./dist/drivers/mock.mjs"
    },
    "./drivers/postmark": {
      "types": "./dist/drivers/postmark.d.mts",
      "default": "./dist/drivers/postmark.mjs"
    },
    "./drivers/resend": {
      "types": "./dist/drivers/resend.d.mts",
